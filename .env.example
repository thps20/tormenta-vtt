# Copie para .env  (cp .env.example .env)

# PostgreSQL (usado pelo docker-compose e pelo Prisma)
POSTGRES_USER=vtt
POSTGRES_PASSWORD=vtt
POSTGRES_DB=tormenta_vtt
POSTGRES_PORT=5432

# Servidor
SERVER_PORT=3000
DATABASE_URL=postgresql://vtt:vtt@localhost:5432/tormenta_vtt?schema=public
CORS_ORIGIN=http://localhost:5173

# Web (Vite só expõe variáveis com prefixo VITE_)
VITE_SERVER_URL=http://localhost:3000
