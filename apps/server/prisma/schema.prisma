// Modelo de dados do MVP. Espelha os schemas Zod em packages/shared/src/schemas.
// Regra: o Prisma guarda ESTADO (posição de token, mapa, chat). Regras de
// sistema (atributos, perícias) NÃO ficam aqui — ficam no JSON do sistema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  gm
  player
}

model Room {
  id            String   @id @default(cuid())
  name          String
  inviteCode    String   @unique
  gmSecret      String
  systemId      String   @default("tormenta20")
  activeSceneId String?
  createdAt     DateTime @default(now())
  /// Grupo da "Visão de grupo" (SPEC §9.15): PartyEntry[] = { characterId, hidden }[], gerenciado
  /// pelo Mestre. Json (não tabela própria) porque é uma lista pequena, sempre reescrita inteira —
  /// mesmo raciocínio de Scene.grid/fog.
  party         Json     @default("[]")

  scenes          Scene[]
  participants    Participant[]
  messages        ChatMessage[]
  combats         Combat[]
  characters      Character[]
  handouts        Handout[]
  savedEncounters SavedEncounter[]
}

model Participant {
  id           String   @id @default(cuid())
  roomId       String
  nickname     String
  role         Role     @default(player)
  /// Token secreto guardado no localStorage do navegador para reconectar como o mesmo participante.
  sessionToken String   @unique @default(cuid())
  createdAt    DateTime @default(now())

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokens     Token[]
  characters Character[]

  @@index([roomId])
}

model Scene {
  id        String    @id @default(cuid())
  roomId    String
  name      String
  mapUrl    String?
  mapWidth  Int?
  mapHeight Int?
  /// GridConfig serializado (ver GridConfigSchema). JSON para não migrar a cada campo novo.
  grid      Json      @default("{\"type\":\"square\",\"cellSize\":70,\"offsetX\":0,\"offsetY\":0,\"color\":\"#00000055\",\"snap\":true}")
  /// FogConfig serializado (ver FogConfigSchema): névoa manual da fase 2.
  fog       Json      @default("{\"enabled\":false,\"base\":\"hidden\",\"shapes\":[]}")
  /// Ordem no painel "Mapas" (arrastar reordena, scene:reorder). Renumerado 0..n-1 a cada reorder;
  /// o backfill desta migration numera as salas existentes por createdAt.
  order     Int       @default(0)
  /// Soft delete (mesmo padrão de Token.deletedAt, docs/plano-mapas.md §10): a linha e tudo que
  /// pende dela (tokens, combate) continuam no banco pra desfazer restaurar; a limpeza definitiva
  /// apaga depois de 30 dias (services/cleanup.ts). null = mapa "existe" normalmente.
  deletedAt DateTime?
  /// ArrivalPointSchema serializado ({ x, y } em pixels do mapa): onde tokens levados de outro mapa
  /// aparecem ao ativar (docs/plano-mapas.md §9). null = sem marcador definido (usa o centro do mapa).
  arrival   Json?
  /// Nota do Mestre sobre o mapa (docs/plano-narracao.md), markdown leve. NUNCA sai no `Scene`
  /// serializado (só `hasNotes: boolean`, calculado em toScene) — o texto só sai por
  /// `scene:get-notes` (GM only), pra nenhum caminho futuro de serialização vazar a nota.
  gmNotes   String?
  createdAt DateTime  @default(now())

  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokens Token[]
  combat Combat?
  pins   Pin[]

  @@index([roomId])
}

model Token {
  id          String    @id @default(cuid())
  sceneId     String
  name        String
  imageUrl    String?
  x           Float
  y           Float
  /// Lado do token em células (docs/plano-grid.md): fonte da verdade do tamanho. Os pixels são
  /// sempre `cells × cellSize do grid ATUAL` (tokenPixelSize, packages/shared) — nunca gravados,
  /// pra não existir "converter tamanho ao trocar de grid" (bug histórico corrigido nesta migration).
  cells       Int       @default(1)
  rotation    Float     @default(0)
  zIndex      Int       @default(0)
  visible     Boolean   @default(true)
  ownerId     String?
  color       String    @default("#e11d48")
  /// Ficha vinculada (token:link-character). Apagar a ficha só desvincula.
  characterId String?
  /// PV do token solto (sem characterId), editado no Inspector: { current, max }. Ver TokenHpSchema.
  /// Ignorado enquanto characterId aponta pra uma ficha (quem manda é o recurso `tokenBar` dela).
  hp          Json?
  /// Condições ativas: array de string (chave, permanente) ou { key, expiresRound } (expira em
  /// combat:next comparado a Combat.round). Ver TokenConditionEntrySchema — Json porque o formato
  /// mistura os dois (campo flexível, mesma convenção de grid/fog/hp).
  conditions  Json      @default("[]")
  /// Nota do Mestre sobre o token (docs/plano-narracao.md), markdown leve. Mesmo padrão de
  /// Scene.gmNotes: NUNCA sai no `Token` serializado (só `hasNotes: boolean`), texto só por
  /// `token:get-notes` (GM only).
  notes       String?
  /// Soft delete (docs/plano-desfazer.md §2): token:delete/token:delete-many só marcam esta data,
  /// não apagam a linha — assim PV/condições/characterId/Combatant sobrevivem pro desfazer restaurar
  /// tudo de graça. null = token "existe" normalmente. Consultas de "tokens da cena agora" filtram
  /// deletedAt: null; a limpeza definitiva (services/cleanup.ts) apaga de vez depois de N dias.
  deletedAt   DateTime?

  scene        Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  owner        Participant?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  character    Character?    @relation(fields: [characterId], references: [id], onDelete: SetNull)
  combatants   Combatant[]
  chatMessages ChatMessage[]

  @@index([sceneId])
  @@index([characterId])
}

/// Ficha de personagem. Só id/dono/nome/tipo são colunas; o resto (atributos,
/// perícias, itens...) é agnóstico de sistema e vai em `data`, validado pelo
/// CharacterDataSchema (Zod) antes de entrar e ao sair.
model Character {
  id                String   @id @default(cuid())
  roomId            String
  ownerId           String?
  name              String
  kind              String // "pc" | "npc"
  data              Json
  /// Id da entrada do compêndio que gerou este NPC (compendium:spawn-creature / encounter:spawn).
  /// Só metadado de app (não é regra de sistema, por isso é coluna e não um campo de `data` validado
  /// por CharacterDataSchema): permite "salvar tokens selecionados como encontro" (§9.14) reconstruir
  /// de qual criatura cada token veio. null = ficha feita à mão (ou PC) — não entra nesse fluxo.
  compendiumEntryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  room   Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  owner  Participant? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tokens Token[]

  @@index([roomId])
}

model ChatMessage {
  id              String   @id @default(cuid())
  roomId          String
  participantId   String
  nickname        String
  kind            String // "text" | "roll" | "system" | "item" | "initiative-batch"
  text            String?
  /// DiceRoll serializado (ver DiceRollSchema) quando kind == "roll".
  roll            Json?
  /// ItemCard serializado (ver ItemCardSchema) quando kind == "item".
  item            Json?
  /// InitiativeBatch serializado (ver InitiativeBatchSchema) quando kind == "initiative-batch":
  /// combat:roll rolando mais de um combatente publica um card só, em vez de um por combatente.
  initiativeBatch Json?
  /// HandoutCard serializado (ver HandoutCardSchema) quando kind == "handout": cópia denormalizada
  /// do handout no momento de handout:show (§9.10) — não muda se o handout original for editado.
  handout         Json?
  /// Quem vê: "all" | "gm" | "self" (ver RollVisibilitySchema). Filtrado no broadcast e no snapshot.
  visibility      String   @default("all")
  /// Token ao qual a rolagem está ligada (combatente de combat:roll, ou personagem com token
  /// vinculado na cena ativa). Quem não vê esse token não recebe a mensagem, nem placeholder
  /// (ver services/chatVisibility.ts). null = sem token, regra normal de visibility. Cards de
  /// iniciativa em lote citam vários tokens dentro de `initiativeBatch`, não aqui (o gate deles
  /// é por linha, não pela mensagem inteira).
  tokenId         String?
  /// Sussurro visual (handout:show "para X", §9.10): setado, só o GM e este participantId recebem
  /// a mensagem — nem card, nem placeholder pros demais (mesmo espírito do gate de tokenId, mas por
  /// pessoa). null = sem sussurro, regra normal de visibility.
  whisperTo       String?
  createdAt       DateTime @default(now())

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  token Token? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([tokenId])
}

/// Combate por cena (docs/plano-combate.md). Um combate ativo por cena (@@unique em sceneId).
model Combat {
  id                String   @id @default(cuid())
  roomId            String
  sceneId           String   @unique
  round             Int      @default(0)
  /// "rolling" | "active" | "ended" (ver CombatStatusSchema).
  status            String   @default("rolling")
  /// Combatente da vez. null = ninguém agindo (rolando iniciativa, ou combate encerrado).
  activeCombatantId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scene      Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  combatants Combatant[]

  @@index([roomId])
}

model Combatant {
  id                 String  @id @default(cuid())
  combatId           String
  tokenId            String
  /// Cópia do token.characterId no momento em que entrou no combate; só informativo
  /// (quem manda em "quem pode agir" é sempre o token atual, ver services/combat.ts).
  characterId        String?
  /// null = ainda não rolou: fica no fim da lista, cinza, sem turno.
  initiative         Float?
  /// Visibilidade (RollVisibility) da ÚLTIMA rolagem que gravou `initiative`: "gm" (rolagem às
  /// cegas de um combatente de jogador) esconde o valor até do dono na lista (toCombat). null =
  /// visível ao dono (nunca rolou às cegas, ou o GM digitou o valor à mão em combat:set-initiative).
  lastRollVisibility String?
  bonus              Float   @default(0)
  delayed            Boolean @default(false)
  surprised          Boolean @default(false)
  /// Desempate final / posição de quem ainda não rolou. Renumerado 0..n-1 a cada mudança.
  order              Int     @default(0)
  /// Rodada em que entrou (reforço). 0 = entrou junto com combat:start.
  addedRound         Int     @default(0)

  /// Orçamento de deslocamento do turno, na unidade do grid (docs/plano-movimento.md). Resolvido e
  /// gravado quando o combatente vira o da vez (services/movement.ts#startTurnMovement); null =
  /// ainda não teve turno, ou o sistema não declara `movement`.
  movementBudget    Float?
  /// Gasto acumulado no turno (mesma unidade) e diagonais já contadas (regra 1-2-1), zerados a
  /// cada troca de turno.
  movementUsed      Float  @default(0)
  movementDiagonals Int    @default(0)
  /// Posição (pixels do mapa) de onde o PRÓXIMO movimento é medido: início do turno, ou fim do
  /// último movimento confirmado (D2 do plano — nunca a posição "ao vivo" de um arraste em curso).
  movementAnchorX   Float?
  movementAnchorY   Float?
  /// Caminho percorrido no turno: [{x,y}] em pixels do mapa, no máximo MOVEMENT_PATH_MAX pontos
  /// (services/movement.ts). null/ausente = turno ainda não começou.
  movementPath      Json?

  combat Combat @relation(fields: [combatId], references: [id], onDelete: Cascade)
  token  Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([combatId, tokenId])
  @@index([combatId])
}

/// Biblioteca de handouts por sala (docs/SPEC.md §9.10): imagem ou texto que o GM mostra pros
/// jogadores (overlay em tela cheia + card no chat) ou fixa no mapa como um Pin (abaixo). Só o GM
/// vê esta tabela (handout:list é gmOnly). `kind` decide quais campos valem.
model Handout {
  id        String    @id @default(cuid())
  roomId    String
  name      String
  kind      String // "image" | "text"
  imageUrl  String?
  width     Int?
  height    Int?
  text      String?
  tags      String[]  @default([])
  /// Soft delete (mesmo padrão de Token.deletedAt): apagar também soft-deleta os pinos deste
  /// handout em qualquer mapa (uma entrada de desfazer só, docs/plano-desfazer.md). null = existe.
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pins Pin[]

  @@index([roomId])
}

/// Pino no mapa (docs/plano-narracao.md): unifica o antigo HandoutPin com o pino de nota pedido
/// pelo dono do projeto. Geometria em pixels do mapa, como Token/Template. `kind` = "image" | "text"
/// (pino de handout — `handoutId` setado, campos de conteúdo são uma CÓPIA denormalizada do Handout
/// no momento de fixar, mesmo padrão de Combatant.name/color: editar o handout original depois não
/// atualiza pinos já fixados) | "note" (pino de nota — `handoutId` null, conteúdo é o próprio dado,
/// escrito direto no pino: `name` faz o papel de título, `text` o corpo, `icon`/`color` a aparência).
model Pin {
  id        String    @id @default(cuid())
  sceneId   String
  kind      String // "image" | "text" | "note"
  /// Só setado em kind "image"/"text" (pino de handout). null em "note".
  handoutId String?
  x         Float
  y         Float
  /// GM controla: pino invisível só aparece pro GM (mesma regra de Token.visible).
  visible   Boolean   @default(true)
  /// Handout: nome do handout. Nota: título do pino.
  name      String?
  imageUrl  String?
  width     Int?
  height    Int?
  /// Handout kind "text": corpo do texto. Nota: corpo da nota.
  text      String?
  /// Só kind "note": chave de SystemDefinition.pinIcons[], ou ausente (paleta padrão do cliente).
  icon      String?
  /// Só kind "note": hex resolvido no cliente a partir do ícone escolhido.
  color     String?
  /// Soft delete (docs/plano-desfazer.md): pin:remove, e a cascata de handout:delete, só marcam
  /// esta data — o desfazer do GM restaura sem precisar de snapshot manual.
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  scene   Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  handout Handout? @relation(fields: [handoutId], references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@index([handoutId])
}

/// Encontro salvo (docs/SPEC.md §9.14): grupo de criaturas do compêndio que o GM monta uma vez e
/// solta no mapa de uma vez (encounter:spawn). Guarda só a "receita" (entryId + quantidade), nunca
/// cópias de ficha — resolvida contra o compêndio ATUAL na hora de soltar.
model SavedEncounter {
  id        String    @id @default(cuid())
  roomId    String
  name      String
  tags      String[]  @default([])
  notes     String    @default("")
  /// SavedEncounterEntry[] serializado (ver SavedEncounterEntrySchema): { entryId, count,
  /// visibleOnSpawn, nameOverride }[].
  entries   Json
  /// Soft delete (mesmo padrão de Handout.deletedAt). null = existe.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}
