// Modelo de dados do MVP. Espelha os schemas Zod em packages/shared/src/schemas.
// Regra: o Prisma guarda ESTADO (posição de token, mapa, chat). Regras de
// sistema (atributos, perícias) NÃO ficam aqui — ficam no JSON do sistema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  gm
  player
}

model Room {
  id            String   @id @default(cuid())
  name          String
  inviteCode    String   @unique
  gmSecret      String
  systemId      String   @default("tormenta20")
  activeSceneId String?
  createdAt     DateTime @default(now())

  scenes       Scene[]
  participants Participant[]
  messages     ChatMessage[]
  combats      Combat[]
  characters   Character[]
}

model Participant {
  id           String   @id @default(cuid())
  roomId       String
  nickname     String
  role         Role     @default(player)
  /// Token secreto guardado no localStorage do navegador para reconectar como o mesmo participante.
  sessionToken String   @unique @default(cuid())
  createdAt    DateTime @default(now())

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokens     Token[]
  characters Character[]

  @@index([roomId])
}

model Scene {
  id        String   @id @default(cuid())
  roomId    String
  name      String
  mapUrl    String?
  mapWidth  Int?
  mapHeight Int?
  /// GridConfig serializado (ver GridConfigSchema). JSON para não migrar a cada campo novo.
  grid      Json     @default("{\"type\":\"square\",\"cellSize\":70,\"offsetX\":0,\"offsetY\":0,\"color\":\"#00000055\",\"snap\":true}")
  /// FogConfig serializado (ver FogConfigSchema): névoa manual da fase 2.
  fog       Json     @default("{\"enabled\":false,\"base\":\"hidden\",\"shapes\":[]}")
  createdAt DateTime @default(now())

  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tokens Token[]
  combat Combat?

  @@index([roomId])
}

model Token {
  id          String   @id @default(cuid())
  sceneId     String
  name        String
  imageUrl    String?
  x           Float
  y           Float
  width       Float
  height      Float
  rotation    Float    @default(0)
  zIndex      Int      @default(0)
  visible     Boolean  @default(true)
  ownerId     String?
  color       String   @default("#e11d48")
  /// Ficha vinculada (token:link-character). Apagar a ficha só desvincula.
  characterId String?
  /// PV do token solto (sem characterId), editado no Inspector: { current, max }. Ver TokenHpSchema.
  /// Ignorado enquanto characterId aponta pra uma ficha (quem manda é o recurso `tokenBar` dela).
  hp          Json?
  /// Chaves de conditions[] do sistema (ex.: "cego", "atordoado"). Só marcador visual por enquanto.
  conditions  String[] @default([])

  scene        Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  owner        Participant?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  character    Character?    @relation(fields: [characterId], references: [id], onDelete: SetNull)
  combatants   Combatant[]
  chatMessages ChatMessage[]

  @@index([sceneId])
  @@index([characterId])
}

/// Ficha de personagem. Só id/dono/nome/tipo são colunas; o resto (atributos,
/// perícias, itens...) é agnóstico de sistema e vai em `data`, validado pelo
/// CharacterDataSchema (Zod) antes de entrar e ao sair.
model Character {
  id        String   @id @default(cuid())
  roomId    String
  ownerId   String?
  name      String
  kind      String // "pc" | "npc"
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  owner  Participant? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tokens Token[]

  @@index([roomId])
}

model ChatMessage {
  id            String   @id @default(cuid())
  roomId        String
  participantId String
  nickname      String
  kind          String // "text" | "roll" | "system" | "item" | "initiative-batch"
  text          String?
  /// DiceRoll serializado (ver DiceRollSchema) quando kind == "roll".
  roll          Json?
  /// ItemCard serializado (ver ItemCardSchema) quando kind == "item".
  item          Json?
  /// InitiativeBatch serializado (ver InitiativeBatchSchema) quando kind == "initiative-batch":
  /// combat:roll rolando mais de um combatente publica um card só, em vez de um por combatente.
  initiativeBatch Json?
  /// Quem vê: "all" | "gm" | "self" (ver RollVisibilitySchema). Filtrado no broadcast e no snapshot.
  visibility    String   @default("all")
  /// Token ao qual a rolagem está ligada (combatente de combat:roll, ou personagem com token
  /// vinculado na cena ativa). Quem não vê esse token não recebe a mensagem, nem placeholder
  /// (ver services/chatVisibility.ts). null = sem token, regra normal de visibility. Cards de
  /// iniciativa em lote citam vários tokens dentro de `initiativeBatch`, não aqui (o gate deles
  /// é por linha, não pela mensagem inteira).
  tokenId       String?
  createdAt     DateTime @default(now())

  room  Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  token Token? @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([tokenId])
}

/// Combate por cena (docs/plano-combate.md). Um combate ativo por cena (@@unique em sceneId).
model Combat {
  id                String   @id @default(cuid())
  roomId            String
  sceneId           String   @unique
  round             Int      @default(0)
  /// "rolling" | "active" | "ended" (ver CombatStatusSchema).
  status            String   @default("rolling")
  /// Combatente da vez. null = ninguém agindo (rolando iniciativa, ou combate encerrado).
  activeCombatantId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  scene      Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  combatants Combatant[]

  @@index([roomId])
}

model Combatant {
  id                 String  @id @default(cuid())
  combatId           String
  tokenId            String
  /// Cópia do token.characterId no momento em que entrou no combate; só informativo
  /// (quem manda em "quem pode agir" é sempre o token atual, ver services/combat.ts).
  characterId        String?
  /// null = ainda não rolou: fica no fim da lista, cinza, sem turno.
  initiative         Float?
  /// Visibilidade (RollVisibility) da ÚLTIMA rolagem que gravou `initiative`: "gm" (rolagem às
  /// cegas de um combatente de jogador) esconde o valor até do dono na lista (toCombat). null =
  /// visível ao dono (nunca rolou às cegas, ou o GM digitou o valor à mão em combat:set-initiative).
  lastRollVisibility String?
  bonus              Float   @default(0)
  delayed            Boolean @default(false)
  surprised          Boolean @default(false)
  /// Desempate final / posição de quem ainda não rolou. Renumerado 0..n-1 a cada mudança.
  order              Int     @default(0)
  /// Rodada em que entrou (reforço). 0 = entrou junto com combat:start.
  addedRound         Int     @default(0)

  combat Combat @relation(fields: [combatId], references: [id], onDelete: Cascade)
  token  Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([combatId, tokenId])
  @@index([combatId])
}
